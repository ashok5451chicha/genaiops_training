digraph G { rankdir=TB; graph [fontname=Arial,dpi=150,pad=0.2,nodesep=0.35,ranksep=0.55]; node [shape=box,style="rounded,filled",fillcolor="#DCE6F2",color="#1F3864",fontname=Arial,fontsize=18]; edge [color="#1F3864",fontname=Arial,fontsize=14];
 a [label="1 Run the starter\nobserve failures"]; b [label="2 Hunt\nlist inconsistencies\n(inconsistency_log.md)"]; c [label="3 Write missing pieces\nwith Claude Code\n(M1 to M6)"]; d [label="4 Fix, one at a time\nrerun after each fix"]; e [label="5 Prove it\ntests pass, pipeline runs,\nhand answers match"]; f [label="6 Push to GitLab\nwalk the trainer through",fillcolor="#E2EFDA"];
 {rank=same;a;b;c} {rank=same;d;e;f} a->b->c; c->d; d->e->f; }
