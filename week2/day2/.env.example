# Copy to .env and paste your programme key. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model IDs used by the Python scripts (change if your organisation approved different ones)
CLAUDE_MODEL_OPUS=claude-opus-5-5
CLAUDE_MODEL_SONNET=claude-sonnet-5-5
CLAUDE_MODEL_HAIKU=claude-haiku-5-5
CLAUDE_MODEL_DEFAULT=claude-sonnet-5-5

# Model aliases passed to the Claude Code CLI
CLAUDE_CLI_MODEL_OPUS=opus
CLAUDE_CLI_MODEL_SONNET=sonnet
CLAUDE_CLI_MODEL_HAIKU=haiku

# Safety / cost knobs
AGENT_MAX_STEPS=8
LLM_MAX_TOKENS=1024
CLAUDE_CLI_TIMEOUT_SECONDS=180
